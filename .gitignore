.env
__pycache__/
*.pyc
data/logs/*.log
data/*.db
tests/facturas_ejemplo/*.pdf
tests/facturas_ejemplo/*.jpg
tests/facturas_ejemplo/*.png
.venv/
venv/

# Servidor web: secretos y archivos subidos
web/config.php
web/almacen_pdf/*
!web/almacen_pdf/.htaccess
config.yaml

# Servidor web: registro de errores (app/bootstrap.php y lib/db.php)
web/logs/*
!web/logs/.htaccess
!web/logs/.gitkeep

# Servidor web: respaldos de PDF generados por scripts/respaldo_pdfs.php
web/respaldos_pdf/*
!web/respaldos_pdf/.htaccess

# Servidor web: fotos subidas por los usuarios (Frutas y Verduras, etc.)
web/uploads/precios_fv/*
!web/uploads/precios_fv/.gitkeep
