# Seguridad general del subdominio admin.minimark.cl

# No listar archivos de las carpetas
Options -Indexes

# Bloquear acceso directo a archivos sensibles (config, esquema, documentacion,
# configuracion de proyecto). Los .php de la app se sirven normal; estos no.
<FilesMatch "(config\.php|config\.ejemplo\.php|\.sql|\.md|\.yaml|\.yml|\.gitignore|\.gitattributes|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Tipo MIME del manifiesto de la app de caja (pos.php). Sin esto algunos
# Apache lo sirven sin tipo y el navegador no ofrece instalarla.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Denegar cualquier archivo oculto (.git, .env, etc.) y la carpeta .git completa.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# Reenviar el header Authorization a PHP. Algunos Apache (ej. XAMPP con
# mod_php) lo omiten, dejando vacío $_SERVER['HTTP_AUTHORIZATION'] y rompiendo
# la autenticación por token del endpoint de sincronización. Inofensivo en
# producción (donde ya llega bien).
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Forzar HTTPS (HostGator emite certificado Let's Encrypt gratis).
# Se excluye el ambiente local (XAMPP) para poder probar por http sin certificado.
RewriteEngine On
RewriteCond %{HTTP_HOST} !=localhost
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTP_HOST} !\.test$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Punto de entrada único (Fase 19 de la migración, ver
# web/docs/01-plan-migracion.md): cualquier dirección que NO sea un archivo
# o carpeta real (css, imágenes, uploads/, api/facturas.php, migrar.php,
# procesar_cortes.php, etc. se siguen sirviendo directo) se manda a
# index.php, que decide con el Router (app/routes.php) qué pantalla
# mostrar. Las direcciones (ej. /herramienta_caja.php) NO cambian para
# quien las usa — index.php lee la dirección pedida y responde igual que
# antes respondía el archivo puente de ese nombre.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
